# Required: Discord bot token
TOKEN=your_discord_bot_token_here

# Optional: sync slash commands immediately to one Discord server
GUILD_ID=

# Optional: Google Gemini API key for AI chat and image descriptions
GEMINI_API_KEY=

# Required: strong admin-panel password (the default admin123 is rejected)
ADMIN_PASSWORD=change_this_to_a_long_random_password

# Optional web server settings
HOST=0.0.0.0
PORT=8080
MAX_UPLOAD_MB=20
