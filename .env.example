# Required: Discord bot token
TOKEN=your_discord_bot_token_here

# Optional: Google Gemini API key for image descriptions
GEMINI_API_KEY=

# Required: strong admin-panel password (the default admin123 is rejected)
ADMIN_PASSWORD=change_this_to_a_long_random_password

# Optional web server settings
HOST=0.0.0.0
PORT=8080
MAX_UPLOAD_MB=20
COOKIE_SECURE=false
# On Render, mount a persistent disk at /var/data and set DATABASE_PATH=/var/data/abi_bot.db
DATABASE_PATH=
# Optional: preserve server, welcome, and log-channel settings across ephemeral hosts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set this only to the IP/CIDR of a trusted reverse proxy, for example 127.0.0.1/32
TRUSTED_PROXY_CIDRS=
