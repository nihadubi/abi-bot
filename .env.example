# Discord Bot Token
TOKEN=your_discord_bot_token_here

# Slash komandaların dərhal görünməsi üçün Discord server ID-si (istəyə bağlı)
GUILD_ID=0

# Render deploy-larında qorunması üçün avtomatik kanal və rol ID-ləri
TEMPVOICE_CHANNEL_ID=0
WELCOME_CHANNEL_ID=0
AUTOROLE_ID=0
LEVEL_UP_CHANNEL_ID=0
REPORT_CHANNEL_ID=0

# Google Gemini API Key (Süni İntellektlə söhbət üçün)
GEMINI_API_KEY=your_gemini_api_key_here

# OwO inteqrasiyası: Developer Mode ilə OwO botuna sağ klik > Copy User ID
OWO_BOT_ID=408785106942164992

# Web Admin Panel Tənzimləmələri
ADMIN_PASSWORD=your_secure_admin_password_here
MAX_UPLOAD_MB=20
PORT=8080
